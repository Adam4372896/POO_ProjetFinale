<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.AjoutProfController">

    <Label text="Ajouter un professeur"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom :"           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="champNom"   GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Nom"/>

        <Label text="Prénom :"        GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="champPrenom" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Prénom"/>

        <Label text="Identifiant :"   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="champId"    GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Identifiant"/>

        <Label text="Salaire :"       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="champSalaire" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Salaire"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleAnnuler"/>
        <Button text="Sauvegarder" onAction="#handleSauvegarder"/>
    </HBox>

</VBox>