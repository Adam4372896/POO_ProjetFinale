<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.AjoutCoursController">

    <Label text="Ajouter un cours"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom :"           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="champNom"   GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Nom du cours"/>

        <Label text="Code :"          GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="champCode"  GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Code du cours"/>

        <Label text="Description :"   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextArea fx:id="champDescription" GridPane.columnIndex="1" GridPane.rowIndex="2"
                  promptText="Description" prefRowCount="3" wrapText="true"/>

        <Label text="Professeur :"    GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="comboProf"   GridPane.columnIndex="1" GridPane.rowIndex="3"
                  maxWidth="Infinity"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleAnnuler"/>
        <Button text="Sauvegarder" onAction="#handleSauvegarder"/>
    </HBox>

</VBox>