<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.example.MainController">

    <Tab text="Accueil">
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 30;">
            <ImageView fitWidth="200" fitHeight="100" preserveRatio="true">
                <image>
                    <Image url="@image/logo-mv-cegep.png"/>
                </image>
            </ImageView>
            <Label text="CÉGEP MARIE-VICTORIN"
                   style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            <Label text="Département d'informatique"
                   style="-fx-font-size: 16;"/>
            <Label text="Bienvenue dans le système scolaire du Cégep Marie-Victorin. Cette application permet de gérer les cours, les professeurs et les étudiants du département d'informatique."
                   wrapText="true" maxWidth="600" textAlignment="CENTER"
                   style="-fx-font-size: 14; -fx-text-fill: gray;"/>
            <Label fx:id="labelDate" style="-fx-font-size: 14; -fx-text-fill: gray;"/>
        </VBox>
    </Tab>

    <Tab fx:id="tabCours" text="Cours">
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Liste des cours" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Button text="Ajouter" onAction="#handleAjouterCours"/>
            <TableView fx:id="tableCours">
                <columns>
                    <TableColumn fx:id="colCoursNom" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="colCoursCode" text="Code" prefWidth="100"/>
                    <TableColumn fx:id="colCoursDescription" text="Description" prefWidth="200"/>
                    <TableColumn fx:id="colCoursProf" text="Professeur" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <Tab fx:id="tabProfs" text="Professeurs">
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Liste des professeurs" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Button text="Ajouter" onAction="#handleAjouterProf"/>
            <TableView fx:id="tableProfs">
                <columns>
                    <TableColumn fx:id="colProfNom" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="colProfPrenom" text="Prénom" prefWidth="150"/>
                    <TableColumn fx:id="colProfId" text="Identifiant" prefWidth="100"/>
                    <TableColumn fx:id="colProfSalaire" text="Salaire" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <Tab fx:id="tabEtudiants" text="Étudiants">
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Liste des étudiants" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Button text="Ajouter" onAction="#handleAjouterEtudiant"/>
            <TableView fx:id="tableEtudiants">
                <columns>
                    <TableColumn fx:id="colEtudiantNom" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="colEtudiantPrenom" text="Prénom" prefWidth="150"/>
                    <TableColumn fx:id="colEtudiantId" text="Identifiant" prefWidth="100"/>
                    <TableColumn fx:id="colEtudiantCoteR" text="Cote R" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <Tab fx:id="tabAPropos" text="À propos">
        <VBox spacing="25" alignment="CENTER" style="-fx-padding: 35; -fx-background-color: #f4f8fb;">
            <Label text="Tableau de bord du système scolaire"
                   style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1f4e79;"/>
            <Label text="Cette page résume les informations enregistrées dans l'application sans utiliser de tableau."
                   wrapText="true" maxWidth="650" textAlignment="CENTER"
                   style="-fx-font-size: 15; -fx-text-fill: #444444;"/>

            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="8" alignment="CENTER" prefWidth="170"
                      style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d6e4f0; -fx-border-radius: 12;">
                    <Label fx:id="labelNbCours" text="0"
                           style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #1f4e79;"/>
                    <Label text="Cours" style="-fx-font-size: 16;"/>
                </VBox>

                <VBox spacing="8" alignment="CENTER" prefWidth="170"
                      style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d6e4f0; -fx-border-radius: 12;">
                    <Label fx:id="labelNbProfs" text="0"
                           style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #1f4e79;"/>
                    <Label text="Professeurs" style="-fx-font-size: 16;"/>
                </VBox>

                <VBox spacing="8" alignment="CENTER" prefWidth="170"
                      style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d6e4f0; -fx-border-radius: 12;">
                    <Label fx:id="labelNbEtudiants" text="0"
                           style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #1f4e79;"/>
                    <Label text="Étudiants" style="-fx-font-size: 16;"/>
                </VBox>
            </HBox>

            <Label text="Projet JavaFX - Gestion simple des cours, des professeurs et des étudiants"
                   style="-fx-font-size: 14; -fx-text-fill: gray;"/>
        </VBox>
    </Tab>

</TabPane>